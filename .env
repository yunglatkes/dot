# Default programs
export EDITOR=/usr/bin/vim
export VISUAL=/usr/bin/vim

# Less
export LESS='--mouse --wheel-lines=3'

# ---- PATH ----
#
# Desktop
export PATH=$PATH:/home/$USER/.local/share/applications

# Rust
export PATH=$PATH:/home/$USER/.cargo/bin
if [ -f /home/$USER/.cargo/bin ]; then
    . export PATH=$PATH:/home/$USER/.cargo/bin
fi

# Ruby
export PATH=$PATH:/home/$USER/.local/share/gem/ruby/3.4.0/bin

# ref https://github.com/BreadOnPenguins/dots/blob/master/.config/zsh/.zprofile
#
# follow XDG base dir specification
#export XDG_CONFIG_HOME="$HOME/.config"
#export XDG_DATA_HOME="$HOME/.local/share"
#export XDG_CACHE_HOME="$HOME/.cache"
