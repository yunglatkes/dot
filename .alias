# bash
alias bconf="vim ~/.bashrc"
alias bup="source ~/.bashrc"

# zsh
alias zconf="vim ~/.zshrc"
alias zup="source ~/.zshrc"

# vim
alias vi="vim"
alias vconf="vim ~/.vimrc"
alias vup="source ~/.vimrc"

# alias
alias aconf="vim ~/.alias"

# enviromental variables
alias econf="vi ~/.env"

# ls
alias ls="ls --color=auto"

# tmux
alias tconf="vim ~/.tmux.conf"
alias tup="tmux source-file ~/.tmux.conf"

# dot files
alias dot="/usr/bin/git --git-dir=$HOME/.dot --work-tree=$HOME"

# python
alias pyenv="source ~/code/venv/bin/activate"

# Debian
alias update="sudo apt update && sudo apt upgrade -y"
alias ate="sudo apt install"

# Arch
alias pac="sudo pacman"
alias pet="sudo pacman -S"
alias pup="sudo pacman -Syu"

# niri
alias niconf="vim ~/.config/niri/config.kdl"

# nvim
alias nv="nvim"
alias nconf="nvim ~/.config/nvim/init.lua"

# games
alias sol="~/code/solVItaire/sol"
alias tetris="tetro-tui"

# ladybird
alias ladybird="cd ~/code/ladybird/ && ./Meta/ladybird.py run && cd -"

# ranger
alias ranger='ranger --choosedir=$HOME/.rangerdir; LASTDIR=`cat $HOME/.rangerdir`; cd "$LASTDIR"'

# w3m
alias ddg="w3m duckduckgo.com"

# Notes
alias note="vi ~/Documents/Notes"

# server
alias hconf="vim ~/Docker/homepage/config/services.yaml"
alias dup="~/.script/dockcheck.sh"
alias dps="~/.script/dps.sh"
alias lazydocker='docker run --rm -it -v /var/run/docker.sock:/var/run/docker.sock -v ~/Docker/lazydocker/config:/.config/jesseduffield/lazydocker lazyteam/lazydocker'
